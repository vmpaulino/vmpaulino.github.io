{
  "name": "vmpaulino-portfolio",
  "version": "1.0.0",
  "description": "Data-driven portfolio website with TypeScript",
  "main": "dist/main.js",
  "scripts": {
    "validate": "node scripts/validate-json.js",
    "build": "npm run validate && tsc && node scripts/copy-assets.js && node scripts/inject-version.js",
    "watch": "tsc --watch",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "test": "npm run build && http-server dist -p 8080"
  },
  "keywords": [
    "portfolio",
    "typescript",
    "bootstrap",
    "fullpage"
  ],
  "author": "Vitor Paulino",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.5"
  },
  "dependencies": {}
}
